# Set these in Netlify → Site configuration → Environment variables.
# Never commit real values.

# Shared passphrase for the console. Every function refuses to run without
# it, and nothing works until it is set. Use a long random string and give
# it only to people who should be able to create orders.
CONSOLE_KEY=

# The store corporate orders belong in. thebrobasket.com runs on
# new-brobasket.myshopify.com (bro-basket.myshopify.com is Go-To Gifting).
SHOPIFY_SHOP=new-brobasket.myshopify.com

# Offline Admin API access token (shpat_...).
# Scopes: read_products, read_inventory, read_shipping,
#         read_draft_orders, write_draft_orders,
#         read_orders, write_orders
SHOPIFY_ADMIN_TOKEN=

SHOPIFY_API_VERSION=2026-07
