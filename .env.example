# Set these in Netlify → Site configuration → Environment variables.
# Never commit real values.

SHOPIFY_SHOP=bro-basket.myshopify.com

# Offline Admin API access token.
#   - A pre-2026 custom app issues a static shpat_... token. Reuse it if one exists.
#   - Otherwise create a Dev Dashboard app; its client-credentials tokens expire
#     roughly every 24h and will need a refresh routine before go-live.
# Scopes needed: read_products, read_inventory, write_orders, write_draft_orders,
#                read_customers, write_customers
SHOPIFY_ADMIN_TOKEN=

SHOPIFY_API_VERSION=2026-07
